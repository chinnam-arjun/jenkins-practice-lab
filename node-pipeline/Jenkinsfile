pipeline {
    agent {
        label 'linux'
    }
    environment {
        withcredentials(
            usernamePassword(
                credentialsId: 'dockerhub-all-access',
                usernameVariable: 'DOCKERHUB_USERNAME',
                passwordVariable: 'DOCKERHUB_PASSWORD'
            )
        )

    }
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'prod'],
            description: 'Select the environment to deploy to'
        )        
    }
    stages{
        stage('checkout') {
            steps {
                checkout scm
            }
        }
        stage('dependencies installation') {
            steps {
                sh 'npm ci --omit=dev'
            }
        }
        stage('linting') {
            steps {
                sh 'npm run lint'
            }
        }
        stage('testing') {
            steps {
                sh 'npm test'
            }
        }
        stage('test coverage') {
            steps {
                sh 'npm run test:coverage'
            }
        }
        stage('build') {
            steps {
                sh 'docker build -t $DOCKERHUB_USERNAME/tasks-app:$ENVIRONMENT .'
            }
        }
        stage('push image') {
            when {
                expression { params.ENVIRONMENT == 'prod' }
            }
            steps {
                sh '''
                echo $DOCKERHUB_PASSWORD | docker login -u $DOCKERHUB_USERNAME --password-stdin
                docker push $DOCKERHUB_USERNAME/tasks-app:$ENVIRONMENT
                '''
            }
        }        
    }
    post {
        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }       
    }
}