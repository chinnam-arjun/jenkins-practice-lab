
pipeline {
    agent {
        label 'linux'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'prod'],
            description: 'Select the environment to deploy to'
        )
    }

    when {
        changeset "**/node-pipeline/**"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('node-pipeline') {
                    sh 'npm ci'
                }
            }
        }

        stage('Linting') {
            steps {
                dir('node-pipeline') {
                    sh 'npm run lint'
                }
            }
        }

        stage('Testing') {
            steps {
                dir('node-pipeline') {
                    sh 'npm test'
                }
            }
        }

        stage('Test Coverage') {
            steps {
                dir('node-pipeline') {
                    sh 'npm run test:coverage'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-all-access',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    dir('node-pipeline') {
                        sh '''
                            docker build \
                                -t "$DOCKERHUB_USERNAME/tasks-app:$ENVIRONMENT" .
                        '''
                    }
                }
            }
        }

        stage('Push Image') {
            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-all-access',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        echo "$DOCKERHUB_PASSWORD" |
                            docker login \
                                -u "$DOCKERHUB_USERNAME" \
                                --password-stdin

                        docker push \
                            "$DOCKERHUB_USERNAME/tasks-app:$ENVIRONMENT"

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
        
    }
}
