pipeline {
  agent { label 'linux' }
  triggers { githubPush() }
  parameters {
    string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Branch to build')
  }

  stages {
    stage('Build') { steps { checkout scm; sh 'ls -la' } }
    stage('Test') { steps { sh 'echo "Running tests..."' } }
}